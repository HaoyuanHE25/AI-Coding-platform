<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.haoyuan</groupId>
        <artifactId>AICodingPlatform-microservice</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>AICodingPlatform-ai</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 与单体（根 pom 的 langchain4j 1.18.1-beta28）保持一致：
             本模块代码是从单体 ai 包平移过来的，1.1.0 里缺少 PartialToolCall 等新 API -->
        <langchain4j.version>1.18.1-beta28</langchain4j.version>
        <!-- langchain4j-community 未发布 1.18.1-beta28，取同为 1.18.x 的最新社区版 -->
        <langchain4j-community.version>1.18.0-beta28</langchain4j-community.version>
    </properties>
    <dependencies>
        <!-- LangChain4j：Spring Boot 3 版 starter（本模块父级是 spring-boot 3.5.3，不能用 boot4 starter） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-reactor</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-redis-spring-boot-starter</artifactId>
            <version>${langchain4j-community.version}</version>
        </dependency>
        <dependency>
            <groupId>com.haoyuan</groupId>
            <artifactId>AICodingPlatform-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.haoyuan</groupId>
            <artifactId>AICodingPlatform-model</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- tools 包里的 FileUtil / StrUtil / JSONUtil / RandomUtil -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>